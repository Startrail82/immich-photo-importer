# Variables for the Docker stack. Most of the connection values can also be entered in the web UI
# (Settings > Connections); values saved in the UI override these.
PUID=1000
PGID=1000

ICLOUD_USERNAME=your-apple-id@example.com
ICLOUD_PASSWORD=
# Exact name of the favorites album; check with: docker exec -it immichphotoimporter photoimporter icloud-check
ICLOUD_FAVORITES_ALBUM=Favorites
# Initial libraries (comma-separated); empty = personal library. You can pick them in the web UI later.
# Shared library: SharedSync-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ICLOUD_LIBRARY=
ICLOUD_WEB_URL=https://photoimporter-icloud.example.com

IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=

# Folders (required). Host paths; IMMICH_TARGET_PATH is the same folder as Immich sees it.
IMPORT_DIR=/mnt/photos/Import
TARGET_DIR=/mnt/photos/Unsorted
IMMICH_TARGET_PATH=/mnt/photos/Unsorted
TZ=Europe/Brussels
