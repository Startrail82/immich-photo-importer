PUID=1024
PGID=100

ICLOUD_USERNAME=jouw-apple-id@voorbeeld.be
ICLOUD_PASSWORD=
# Exacte naam van het favorietenalbum; controleer met: docker exec -it immichphotoimporter photoimporter icloud-check
ICLOUD_FAVORITES_ALBUM=Favorites
# Beginwaarde voor de bibliotheken (kommagescheiden); leeg = persoonlijke. Later kies je ze in de webinterface.
# Gedeelde bibliotheek: SharedSync-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ICLOUD_LIBRARY=
ICLOUD_WEB_URL=https://immichphotoimporter-icloud.bluelight.one

IMMICH_URL=https://immich.bluelight.one
IMMICH_API_KEY=
